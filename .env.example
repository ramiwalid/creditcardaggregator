# Copy to .env and fill in. Used by the FastAPI backend in api/.

# Required. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: where the frontend runs (used in reset links + CORS).
FRONTEND_URL=http://localhost:3000

# Optional: SMTP for password reset emails. If unset, reset links are printed
# to the API console instead, which is handy for local development.
# For Gmail, use an App Password (https://myaccount.google.com/apppasswords).
SMTP_USER=
SMTP_PASSWORD=
# Inbox that receives landing-page contact form messages.
CONTACT_INBOX=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Optional: override the SQLite file location (defaults to ./sql_app.db).
# QUANTA_DATABASE_URL=sqlite:////absolute/path/to/sql_app.db

# Frontend (Next.js) – where the API lives.
NEXT_PUBLIC_API_URL=http://localhost:8000
